# ChavrusaNotes delivery lanes. Signing follows the ChavrusaText model:
# one installed Apple Distribution certificate plus one explicit App Store
# profile for every signed bundle.

opt_out_usage

platform :ios do
  APP_ID = "com.itorah.chavrusanotes"
  SHARE_ID = "com.itorah.chavrusanotes.share"
  WIDGETS_ID = "com.itorah.chavrusanotes.widgets"
  TEAM_ID = "NA6HPWARQ2"

  def load_asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  def build_xcframework_if_needed
    framework_path = File.expand_path("../pinkha.xcframework", __dir__)
    sh("../build-xcframework.sh", "release") unless Dir.exist?(framework_path) && !Dir.empty?(framework_path)
  end

  def profile_mapping
    {
      APP_ID => ENV.fetch("CHAVRUSANOTES_MAIN_PROFILE"),
      SHARE_ID => ENV.fetch("CHAVRUSANOTES_SHARE_PROFILE"),
      WIDGETS_ID => ENV.fetch("CHAVRUSANOTES_WIDGETS_PROFILE"),
    }
  end

  def signing_xcargs
    [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      "CODE_SIGN_STYLE=Manual",
      'CODE_SIGN_IDENTITY="Apple Distribution"',
      "CHAVRUSANOTES_MAIN_PROFILE=\"#{ENV.fetch('CHAVRUSANOTES_MAIN_PROFILE')}\"",
      "CHAVRUSANOTES_SHARE_PROFILE=\"#{ENV.fetch('CHAVRUSANOTES_SHARE_PROFILE')}\"",
      "CHAVRUSANOTES_WIDGETS_PROFILE=\"#{ENV.fetch('CHAVRUSANOTES_WIDGETS_PROFILE')}\"",
    ].join(" ")
  end

  def bump_build_number(api_key)
    number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1
    increment_build_number(build_number: number, xcodeproj: "app/Pinkha.xcodeproj")
    number
  end

  def build_signed_app
    build_xcframework_if_needed
    build_app(
      project: "app/Pinkha.xcodeproj",
      scheme: "PinkhaRelease",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store-connect",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: TEAM_ID,
        provisioningProfiles: profile_mapping,
      },
      xcargs: signing_xcargs,
      output_directory: "build/",
      output_name: "ChavrusaNotes.ipa",
      clean: true,
      include_symbols: true,
      include_bitcode: false,
    )
  end

  desc "Build and upload ChavrusaNotes to TestFlight"
  lane :beta do
    ensure_git_branch(branch: "beta-test") unless ENV["SKIP_BRANCH_CHECK"]
    api_key = load_asc_api_key
    bump_build_number(api_key)
    build_signed_app
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ChavrusaNotes.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      changelog: (File.exist?("fastlane/changelog.txt") ? File.read("fastlane/changelog.txt") : `git log -1 --pretty=%s`.strip).slice(0, 4000),
    )
  end

  desc "Upload an App Store candidate without submitting it for review"
  lane :release do
    ensure_git_branch(branch: "master") unless ENV["SKIP_BRANCH_CHECK"]
    api_key = load_asc_api_key
    bump_build_number(api_key)
    build_signed_app
    upload_to_app_store(
      api_key: api_key,
      ipa: "build/ChavrusaNotes.ipa",
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
